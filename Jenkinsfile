pipeline {
  agent any

  options {
    skipDefaultCheckout(true)
    timestamps()
  }

  environment {
    REPORT_FILE = ""
    REPORT_URL  = ""
  }

  stages {

    stage('Checkout') {
      steps {
        checkout scm
      }
    }

    stage('Verify k6') {
      steps {
        sh 'k6 version'
      }
    }

    stage('Run k6 Test') {
      steps {
        sh '''
          set -e
          echo "Running k6 load test..."
          ls -l
          k6 run script.js
        '''
      }
    }

    stage('Collect Report') {
      steps {
        script {
          def reportFile = sh(
            script: "ls -1 report_*.html 2>/dev/null | sort | tail -n 1 || true",
            returnStdout: true
          ).trim()

          if (reportFile) {
            env.REPORT_FILE = reportFile
            env.REPORT_URL  = "${env.BUILD_URL}artifact/${reportFile}"
            echo "Found report: ${env.REPORT_FILE}"
            echo "Report URL : ${env.REPORT_URL}"
          } else {
            echo "No report generated by k6"
          }
        }
      }
    }
  }

  post {

    always {
      script {
        if (env.REPORT_FILE?.trim()) {
          archiveArtifacts artifacts: "${env.REPORT_FILE}", fingerprint: true
        } else {
          echo "Skipping artifact archive — no report file"
        }
      }
    }

    success {
      slackSend(
        channel: "#all-poc-k6",
        message: """✅ *k6 POC PASSED*
• Job: ${env.JOB_NAME}
• Build: ${env.BUILD_NUMBER}
• Report: ${env.REPORT_URL}
"""
      )
    }

    failure {
      slackSend(
        channel: "#all-poc-k6",
        message: """❌ *k6 POC FAILED*
• Job: ${env.JOB_NAME}
• Build: ${env.BUILD_NUMBER}
• Logs: ${env.BUILD_URL}
"""
      )
    }
  }
}
